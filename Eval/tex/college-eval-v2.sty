% tex/college-eval.sty
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{college-eval-v2}[2025/10/04 v2.0 College evaluations kit - Enhanced]

% -------- Options ----------
\newif\ifcorrige \corrigefalse
\DeclareOption{corrige}{\corrigetrue}
\ProcessOptions\relax

% -------- Packages de base (Lua/XeLaTeX) ----------
\RequirePackage{fontspec}
\RequirePackage[french]{babel}
\RequirePackage[final]{microtype}
\RequirePackage{siunitx}
\sisetup{locale=FR, group-minimum-digits=4}

\RequirePackage{amsmath,amssymb}
\RequirePackage{geometry}
\geometry{top=1.5cm,bottom=2cm,left=1.8cm,right=1.8cm}
\RequirePackage{fancyhdr}
\setlength{\headheight}{15pt}
\RequirePackage{enumitem}
\RequirePackage{multicol}
\RequirePackage{tikz}
\usetikzlibrary{calc,arrows.meta,shapes.geometric,positioning,backgrounds}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{array}
\RequirePackage{fontawesome5}
\RequirePackage{tabularx}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins,breakable}

% -------- Couleurs ----------
\definecolor{primary}{RGB}{41,128,185}      % Bleu moderne
\definecolor{secondary}{RGB}{52,73,94}      % Gris foncé
\definecolor{accent}{RGB}{46,204,113}       % Vert menthe
\definecolor{warning}{RGB}{231,76,60}       % Rouge moderne
\definecolor{light}{RGB}{236,240,241}       % Gris très clair
\definecolor{bglight}{RGB}{247,249,250}     % Fond clair
\definecolor{info}{RGB}{52,152,219}         % Bleu info
\definecolor{success}{RGB}{39,174,96}       % Vert succès

% -------- Toggle corrigé ----------
\DeclareRobustCommand{\rep}[1]{%
	\ifcorrige \begingroup\color{warning}\ifmmode #1\else \textbf{#1}\fi\endgroup \fi}
\newcommand{\onlycorrige}[1]{\ifcorrige #1\fi}
\newcommand{\onlyeleve}[1]{\ifcorrige\else #1\fi}

% -------- En-tête / pied ----------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[C]{\color{secondary}\thepage}

% -------- Métadonnées de l'épreuve ----------
\def\ExamLevel{6e}
\def\ExamSubject{Mathématiques}
\def\ExamTitle{Titre}
\def\ExamNumber{1}
\def\ExamDuration{50 minutes}
\def\ExamCalc{Calculatrice interdite}

\newcommand{\examsetup}[6]{%
	\def\ExamLevel{#1}%
	\def\ExamSubject{#2}%
	\def\ExamTitle{#3}%
	\def\ExamNumber{#4}%
	\def\ExamDuration{#5}%
	\def\ExamCalc{#6}%
	\fancyhead[L]{\color{secondary}\textbf{\ExamLevel}\,|\,\ExamSubject}%
	\fancyhead[R]{\color{secondary}\textbf{\ifcorrige Corrigé — \ExamTitle\else \ExamTitle\fi}}%
}

% -------- Bandeau haut ----------
\newcommand{\ExamBanner}{%
	\begin{tikzpicture}[remember picture,overlay]
		\fill[primary] (current page.north west) rectangle ([yshift=-3.5cm]current page.north east);
		\node[anchor=north west,text=white,font=\Huge\bfseries]
		at ([xshift=2cm,yshift=-1cm]current page.north west)
		{\ifcorrige Corrigé — Contrôle n° \ExamNumber \else Contrôle n° \ExamNumber\fi};
		\node[anchor=north west,text=white,font=\Large]
		at ([xshift=2cm,yshift=-2cm]current page.north west) {\ExamTitle};
		\node[anchor=north east,text=white,font=\large]
		at ([xshift=-2cm,yshift=-1.5cm]current page.north east) {\faIcon{clock} \ExamDuration};
		\node[anchor=north east,text=white,font=\large]
		at ([xshift=-2cm,yshift=-2.3cm]current page.north east) {\faIcon{calculator} \ExamCalc};
	\end{tikzpicture}
	\vspace*{1.5cm}
}

% -------- Filigrane corrigé ----------
\newcommand{\CorrigeWatermark}{%
	\onlycorrige{%
		\begin{tikzpicture}[remember picture,overlay]
			\node[rotate=30,scale=8,text=secondary!12] at (current page.center) {CORRIGÉ};
\end{tikzpicture}}}

% -------- Boîtes améliorées (élargies) ----------
\newtcolorbox{exercisebox}[2][]{
	colback=white,colframe=primary,
	fonttitle=\bfseries\large,
	title={#2},
	arc=2mm,boxrule=1.5pt,
	left=15pt,right=15pt,top=12pt,bottom=12pt,
	boxsep=0pt,breakable,enhanced,
	width=\linewidth,
	grow to left by=5mm,    % Élargi de 3mm à 5mm
	grow to right by=5mm,   % Élargi de 3mm à 5mm
	#1
}

\newtcolorbox{consignebox}{
	colback=light!30,colframe=secondary,
	arc=3mm,boxrule=0pt,leftrule=4pt,
	left=15pt,right=15pt,top=12pt,bottom=12pt,
	enhanced,width=\linewidth,
	grow to left by=5mm,    % Élargi de 3mm à 5mm
	grow to right by=5mm    % Élargi de 3mm à 5mm
}

% -------- Nouvelles boîtes thématiques ----------
\newtcolorbox{qcmbox}[2][]{
	colback=info!5,colframe=info,
	fonttitle=\bfseries\large,
	title={#2},
	arc=2mm,boxrule=1.5pt,
	left=15pt,right=15pt,top=12pt,bottom=12pt,
	boxsep=0pt,breakable,enhanced,
	width=\linewidth,
	grow to left by=5mm,
	grow to right by=5mm,
	#1
}

\newtcolorbox{constructionbox}[2][]{
	colback=accent!5,colframe=accent,
	fonttitle=\bfseries\large,
	title={#2},
	arc=2mm,boxrule=1.5pt,
	left=15pt,right=15pt,top=12pt,bottom=12pt,
	boxsep=0pt,breakable,enhanced,
	width=\linewidth,
	grow to left by=5mm,
	grow to right by=5mm,
	#1
}

\newtcolorbox{problembox}[2][]{
	colback=warning!5,colframe=warning,
	fonttitle=\bfseries\large,
	title={#2},
	arc=2mm,boxrule=1.5pt,
	left=15pt,right=15pt,top=12pt,bottom=12pt,
	boxsep=0pt,breakable,enhanced,
	width=\linewidth,
	grow to left by=5mm,
	grow to right by=5mm,
	#1
}

% -------- Macros utiles ----------
\newcommand{\points}[1]{\hfill \colorbox{primary}{\color{white}\textbf{\,#1 pts\,}}}
\newcommand{\badge}[2]{\tikz[baseline=(char.base)]{\node[shape=rectangle,draw,thick,rounded corners=2mm,inner sep=2pt,fill=#1,text=white,font=\footnotesize\bfseries] (char) {#2};}}
\newcommand{\dotline}[1]{\makebox[#1][s]{\dotfill}}
\newcolumntype{L}[1]{>{\hsize=#1\hsize\arraybackslash}X}

% Zones de réponse
\newcommand{\zonereponse}[1]{\par\noindent\colorbox{light}{\parbox{\dimexpr\linewidth-2\fboxsep\relax}{\vspace{#1}}}\par}
\newcommand{\zonereponseLignes}[2][0.9cm]{\par\noindent\colorbox{light}{\parbox{\dimexpr\linewidth-2\fboxsep\relax}{\setlength{\parskip}{#1}\foreach \i in {1,...,#2}{\noindent\dotfill\par}}}\par}

% -------- Cartouche élève amélioré ----------
\newcommand{\StudentInfoBox}{%
	\begin{tcolorbox}[colback=bglight,colframe=secondary,arc=3mm,boxrule=1pt,
		left=15pt,right=15pt,top=10pt,bottom=10pt,enhanced,width=\linewidth,
		grow to left by=5mm, grow to right by=5mm]  % Élargi
		\noindent
		\begin{minipage}{0.78\linewidth}
			\setlength{\tabcolsep}{4pt}
			\begin{tabularx}{\linewidth}{@{} l L{1.5} l L{0.2} @{}}
				\faIcon{user}\ \textbf{NOM :} & \dotfill &
				\textbf{Classe :} & \dotfill \\
				[0.35cm]
				\textbf{Prénom :} & \dotfill &
				\faIcon{calendar}\ \textbf{Date :} & \dotfill \\
			\end{tabularx}
		\end{minipage}\hfill
		\begin{minipage}{0.20\linewidth}
			\raggedleft
			\fcolorbox{secondary}{white}{\textbf{NOTE : }\makebox[1cm]{\rule{0pt}{1.1em}}\textbf{ / 20}}
		\end{minipage}
\end{tcolorbox}
}

% -------- Helpers de réponses (élève/corrigé) ----------
\providecommand{\ansblockcolor}{warning}
\newcommand{\ans}[1]{\ifcorrige \rep{#1}\else \dotfill\fi}
\newcommand{\anslines}[3][0.35cm]{\ifcorrige {\color{\ansblockcolor}#3}\else \zonereponseLignes[#1]{#2}\fi}

% Nouvelle commande pour réponse simple
\newcommand{\blanks}[1]{\ifcorrige \rep{#1}\else \underline{\hspace{#1}}\fi}

% -------- Fonction pour créer un barème automatiquement ----------
\newcommand{\bareme}[1]{%
	\begin{center}
		#1
	\end{center}
	\vspace{0.2cm}
}

% Fonction helper pour créer des badges rapidement
\newcommand{\exbadge}[2]{\badge{primary}{Ex.#1: #2pts}}
\newcommand{\bonusbadge}[1]{\badge{accent}{Bonus: +#1pts}}

% -------- QCM helper ----------
% Utilisation: Dans le contenu du tableau, pas besoin de cette commande

% -------- Tableau QCM standard ----------
\newenvironment{qcmtable}{%
	\small\setlength{\tabcolsep}{4pt}\renewcommand{\arraystretch}{1.25}%
	\begin{tabular}{|p{0.45\linewidth}|p{0.1\linewidth}|p{0.1\linewidth}|p{0.1\linewidth}|p{0.1\linewidth}|}
	\hline
	\textbf{Question} & \centering\textbf{Rép. A} & \centering\textbf{Rép. B} & \centering\textbf{Rép. C} & \centering\arraybackslash\textbf{Corrigé} \\
	\hline
}{%
	\end{tabular}%
}

% -------- Construction géométrique helper ----------
\newcommand{\figureespace}[1]{\vspace{#1}}

% -------- Auto-évaluation (pied de page) ----------
\newcommand{\AutoEval}{%
	\vspace{0.3cm}
	\begin{center}
		\begin{tikzpicture}
			\node[draw=secondary,rounded corners=3mm,inner sep=8pt,fill=light!30] {
				\begin{tabular}{lccccc}
					\textbf{Auto-évaluation :} &
					\faIcon{frown} Difficile &
					\faIcon{meh} Moyen &
					\faIcon{smile} Facile &
					\phantom{xx} &
					\textbf{Temps utilisé :} \underline{\phantom{xxxxx}} min
				\end{tabular}
			};
		\end{tikzpicture}
	\end{center}
}

% -------- Espacement vertical adaptatif ----------
\newcommand{\exspace}{\vspace{0.3cm}}
\newcommand{\smallspace}{\vspace{0.2cm}}

% -------- Coloration automatique des étapes en mode corrigé ----------
\RequirePackage{etoolbox}
\ifcorrige
  \AtBeginEnvironment{align}{\color{warning}}
  \AtBeginEnvironment{align*}{\color{warning}}
  \AtBeginEnvironment{equation}{\color{warning}}
  \AtBeginEnvironment{equation*}{\color{warning}}
  \AtBeginEnvironment{gather}{\color{warning}}
  \AtBeginEnvironment{gather*}{\color{warning}}
\fi

% -------- Commandes pour divisions posées (optionnel) ----------
\RequirePackage{xlop}
\newif\ifshowoperations
\showoperationstrue  % Par défaut, on montre les opérations

\newcommand{\AddPose}[2]{%
	\ifcorrige
		\opadd[displayintermediary=all]{#1}{#2}%
	\else
		\opadd[displayintermediary=all,resultstyle=\color{white}]{#1}{#2}%
	\fi
}

\newcommand{\SubPose}[2]{%
	\ifcorrige
		\opsub[displayintermediary=all]{#1}{#2}%
	\else
		\opsub[displayintermediary=all,resultstyle=\color{white},intermediarystyle=\color{white}]{#1}{#2}%
	\fi
}

\newcommand{\MulPose}[2]{%
	\ifcorrige
		\opmul[displayintermediary=all]{#1}{#2}%
	\else
		\opmul[displayintermediary=all,resultstyle=\color{white},intermediarystyle=\color{white}]{#1}{#2}%
	\fi
}

\newcommand{\DivEuc}[2]{%
	\ifcorrige
		\opidiv[displayintermediary=all]{#1}{#2}%
	\else
		\opidiv[displayintermediary=all,resultstyle=\color{white},remainderstyle=\color{white},intermediarystyle=\color{white}]{#1}{#2}%
	\fi
}

% -------- Grille de compétences (optionnel) ----------
\newcommand{\CompetencesGrid}[1]{%
	\begin{tcolorbox}[colback=bglight,colframe=secondary,arc=3mm,boxrule=1pt,
		title={\faIcon{tasks} Compétences évaluées},fonttitle=\bfseries,
		left=10pt,right=10pt,top=8pt,bottom=8pt]
		\small
		\begin{itemize}[leftmargin=*,noitemsep]
			#1
		\end{itemize}
	\end{tcolorbox}
}

% -------- Template pour exercice type ----------
% Usage: \ExTemplate{Numéro}{Titre}{Points}{Icône}{Contenu}
\newcommand{\ExTemplate}[5]{%
	\begin{exercisebox}{\faIcon{#4} Exercice #1 : #2 \points{#3}}
		#5
	\end{exercisebox}
	\exspace
}

% -------- Template pour QCM ----------
\newcommand{\QCMTemplate}[3]{%
	\begin{qcmbox}{\faIcon{list-ul} #1 \points{#2}}
		Pour chaque question, écris la lettre de la seule réponse correcte dans la colonne de droite :
		\vspace{0.3cm}
		
		\begin{qcmtable}
			#3
		\end{qcmtable}
	\end{qcmbox}
	\exspace
}
